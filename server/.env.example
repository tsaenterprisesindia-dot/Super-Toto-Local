# Super Toto Local — server environment
# Copy to server/.env to use a persistent MongoDB (Atlas/local) instead of in-memory.
MONGODB_URI=

# JWT signing secret (REQUIRED for any non-local run; used to sign all auth tokens).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# The server refuses to start in production without it.
JWT_SECRET=

# UPI payment handle for the operator (optional). Defaults to empty; the operator
# can also set it in Admin → Settings → UPI. Never hardcode a personal UPI in source.
UPI_ID=

# Face recognition: max Euclidean distance (on L2-normalized descriptors) to
# accept as a genuine match. Lower is stricter. face-api.js descriptors
# usually score ~0.0–0.6 for the same person and ~0.75+ for different.
FACE_MATCH_THRESHOLD=0.6

# Road-based fares: an OSRM-compatible routing server is queried for driving
# distance + duration so fares/ETAs reflect real roads. Falls back to
# straight-line (haversine) distance when the server is unreachable or when
# OSRM_DISABLED=1. Default is the free public OSRM demo server.
OSRM_URL=https://router.project-osrm.org
OSRM_TIMEOUT_MS=3000
# OSRM_DISABLED=1

# API port (default 5000)
PORT=5000
