{
  "name": "super-toto-local",
  "private": true,
  "version": "1.0.0",
  "description": "Ride-hailing app for local totos - rider, driver & admin web app (MERN)",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "seed": "npm run seed -w server",
    "build": "cd client && npx --no-install vite build",
    "start:prod": "node server/src/index.js"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.0",
    "vite": "^5.4.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "mongodb-memory-server@10.4.3": true
  }
}
